#!/usr/bin/env bash
# Dominique-Oliveira-ChatGPT🤖💚 — controla somente o projeto Docker Pé na Universidade (PU).
set -euo pipefail
PASTA_VPT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
cd "$PASTA_VPT"
if ! command -v docker >/dev/null 2>&1; then
  echo 'Docker não encontrado no PATH.' >&2; exit 1
fi
# Usa o Docker rootless já existente quando nenhuma configuração foi fornecida.
if [[ -z "${DOCKER_HOST:-}" && -z "${DOCKER_CONTEXT:-}" && -S "/run/user/$(id -u)/docker.sock" ]]; then
  export DOCKER_HOST="unix:///run/user/$(id -u)/docker.sock"
fi
ARQUIVOS_VPT=(-f "$PASTA_VPT/compose.yaml")
if [[ -f "$PASTA_VPT/.segredos/conector" && -f "$PASTA_VPT/.segredos/ativado" ]]; then
  ARQUIVOS_VPT+=(-f "$PASTA_VPT/compose.publico.yaml")
fi
compor() { docker compose "${ARQUIVOS_VPT[@]}" "$@"; }
case "${1:-ligar}" in
  ligar|iniciar|reiniciar)
    if ! docker info >/dev/null 2>&1; then
      systemctl --user start docker.service
    fi
    python3 "$PASTA_VPT/scripts/sincronizar-questoes.py"
    docker build -f ambiente/Dockerfile -t pu-individual:local .
    python3 "$PASTA_VPT/gerenciador/iniciar.py"
    compor up -d --build --wait --force-recreate
    echo 'Pé na Universidade (PU) ligado: http://localhost:8088'
    ;;
  parar|desligar) compor stop; python3 "$PASTA_VPT/gerenciador/parar.py"; echo 'Pé na Universidade (PU) parado. Dados preservados.' ;;
  status) compor ps -a ;;
  logs) compor logs -f --tail 50 ;;
  ajuda|-h|--help) echo 'pu [ligar|parar|reiniciar|status|logs|ajuda]' ;;
  *) echo 'Comando desconhecido. Use: pu ajuda' >&2; exit 2 ;;
esac
